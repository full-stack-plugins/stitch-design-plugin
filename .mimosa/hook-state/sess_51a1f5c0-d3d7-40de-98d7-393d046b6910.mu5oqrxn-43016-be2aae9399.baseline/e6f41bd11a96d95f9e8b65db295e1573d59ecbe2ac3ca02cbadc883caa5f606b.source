name: Live Provider and Asset Smoke

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: stitch-design-live-canary
  cancel-in-progress: false

jobs:
  live-canary:
    name: Controlled Stitch provider and asset smoke
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.13"
      - name: Install pinned test and Harness dependencies
        run: python -m pip install -r requirements-test.txt -r requirements-harness.txt
      - name: Require repository credential
        shell: bash
        env:
          STITCH_API_KEY: ${{ secrets.STITCH_API_KEY }}
        run: test -n "${STITCH_API_KEY:-}" || { echo 'Required repository secret is not configured.' >&2; exit 2; }
      - name: Run bounded canary chain
        env:
          STITCH_API_KEY: ${{ secrets.STITCH_API_KEY }}
        run: >-
          python scripts/live_canary.py run
          --state "$RUNNER_TEMP/stitch-live-canary/private-state.json"
          --evidence "$RUNNER_TEMP/stitch-live-canary/sanitized-evidence.json"
          --workspace "$RUNNER_TEMP/stitch-live-canary/workspace"
      - name: Validate sanitized evidence schema
        run: >-
          python scripts/live_canary.py validate-evidence-schema
          --evidence "$RUNNER_TEMP/stitch-live-canary/sanitized-evidence.json"
      - name: Cleanup remote project and prove absence
        if: ${{ always() }}
        env:
          STITCH_API_KEY: ${{ secrets.STITCH_API_KEY }}
        run: |
          python scripts/live_canary.py cleanup \
            --state "$RUNNER_TEMP/stitch-live-canary/private-state.json" \
            --evidence "$RUNNER_TEMP/stitch-live-canary/sanitized-evidence.json" \
            --reconciliation-attempts 3 \
            --reconciliation-backoff-seconds 2
          python scripts/live_canary.py validate-acceptance \
            --evidence "$RUNNER_TEMP/stitch-live-canary/sanitized-evidence.json"
